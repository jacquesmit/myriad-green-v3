{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/contact",
        "function": "sendContactEmail"
      },
      {
        "source": "/api/magos/social-generate",
        "function": "magosSocialGenerateWorker"
      }
    ]
  },
  "functions": {
    "runtime": "nodejs20"
  }
}
