rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    // Bookings collection — only Cloud Functions can write
    // Clients can only read their own bookings (if needed)
    match /bookings/{document=**} {
      // Only authenticated users can read their own bookings (optional)
      // For now, all reads are denied unless from a function
      allow read, write: if false;
    }

    // Quotes collection — similar protection
    match /quotes/{document=**} {
      allow read, write: if false;
    }

    // Invoices collection
    match /invoices/{document=**} {
      allow read, write: if false;
    }

    // Service reports collection
    match /serviceReports/{document=**} {
      allow read, write: if false;
    }
  }
}
